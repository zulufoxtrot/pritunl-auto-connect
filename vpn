#!/usr/bin/env python3
"""vpn — lightweight, cross-platform Pritunl VPN client (stdlib-only core).

Wraps the ``pritunl-client`` CLI with automatic TOTP (RFC 6238) generation,
a sleep-safe watchdog that keeps the tunnel connected, an enable/disable
switch, and a diagnostics command.

Commands:
  connect       Connect the profile using PIN + TOTP
  disconnect    Disconnect the profile
  status        Show profile state (exit code 0 = connected, 1 = not)
  totp          Print the current TOTP code (--copy puts it on the clipboard)
  enable        Enable auto-reconnect (watchdog reconnects when down)
  disable       Disable auto-reconnect and disconnect immediately
  enabled       Print whether auto-reconnect is enabled
  ensure        Connect if not connected and auto-reconnect is enabled
  daemon        Run the watchdog loop (used by the service manager)
  diag          Snapshot routing / DNS / reachability (diagnose sleep issues)
  install       Install the service manager unit (daemon + optional tray)
  uninstall     Remove the service manager units

Config: ~/.config/vpn-connector/config.json (0600)
  {
    "profile_id": "<pritunl-client profile id>",     # optional, auto-detected
    "totp_secret": "BASE32SECRET",                      # required
    "pin": "555555",                                    # optional
    "pritunl_client": "/path/to/pritunl-client",      # optional, auto-detected
    "auto_wifi_reset": false                          # optional, default off
  }

Runtime state: ~/.config/vpn-connector/state.json
  { "enabled": true }

Supported platforms: macOS (launchd) and Linux/Ubuntu (systemd user units).
The tray UI lives in the sibling ``tray.py`` and needs ``pystray`` + Pillow.
"""

import argparse
import base64
import hashlib
import hmac
import json
import os
import platform
import shutil
import struct
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

IS_MAC = sys.platform == "darwin"
IS_LINUX = sys.platform.startswith("linux")

HOME = Path.home()
HERE = Path(__file__).resolve().parent
CONFIG_DIR = HOME / ".config" / "vpn-connector"
CONFIG_PATH = CONFIG_DIR / "config.json"
STATE_PATH = CONFIG_DIR / "state.json"

WATCHDOG_INTERVAL = 5
CONNECT_TIMEOUT = 25
# When the profile has been down this many consecutive checks and we still
# cannot bring it up, optionally reset Wi-Fi (if auto_wifi_reset is enabled).
WAKE_SETTLE_SECONDS = 8
WIFI_RESET_AFTER_FAILS = 3

if IS_MAC:
    SERVICE_LABEL = "com.local.vpn-daemon"
    TRAY_LABEL = "com.local.vpn-tray"
    PLIST_PATH = HOME / "Library" / "LaunchAgents" / (SERVICE_LABEL + ".plist")
    TRAY_PLIST_PATH = HOME / "Library" / "LaunchAgents" / (TRAY_LABEL + ".plist")
    LOG_PATH = HOME / "Library" / "Logs" / "vpn-connector.log"
    DEFAULT_CLIENT = "/Applications/Pritunl.app/Contents/Resources/pritunl-client"
elif IS_LINUX:
    SERVICE_LABEL = "pritunl-auto-reconnect"
    TRAY_LABEL = "pritunl-auto-reconnect-tray"
    LOG_PATH = HOME / ".local" / "state" / "vpn-connector.log"
    DEFAULT_CLIENT = "/usr/bin/pritunl-client"
else:
    SERVICE_LABEL = "vpn-daemon"
    TRAY_LABEL = "vpn-tray"
    LOG_PATH = HOME / ".vpn-connector.log"
    DEFAULT_CLIENT = "pritunl-client"


class VPNError(Exception):
    pass


# ---------------------------------------------------------------------------
# Platform operations
#
# All OS-specific behaviour lives behind this interface so the core logic
# stays shared between macOS and Linux.
# ---------------------------------------------------------------------------


class PlatformOps:
    """Shared logic; subclasses override the handful of OS-specific bits."""

    name = "generic"

    def detect_client(self, cfg: Dict[str, Any]) -> str:
        from_cfg = cfg.get("pritunl_client")
        if from_cfg:
            return from_cfg
        found = shutil.which("pritunl-client") or shutil.which("pritunl")
        return found or DEFAULT_CLIENT

    # --- service manager ---
    def install_service(self, script: Path, python: Path, log: Path) -> Tuple[int, str]:
        raise NotImplementedError

    def uninstall_service(self) -> int:
        raise NotImplementedError

    def install_tray(self, script: Path, python: Path) -> Tuple[int, str]:
        raise NotImplementedError

    def uninstall_tray(self) -> int:
        raise NotImplementedError

    # --- clipboard ---
    def copy_to_clipboard(self, text: str) -> None:
        raise NotImplementedError

    # --- network diagnostics / reset ---
    def default_route(self) -> str:
        raise NotImplementedError

    def dns_servers(self) -> str:
        raise NotImplementedError

    def wifi_reset(self) -> Tuple[int, str]:
        raise NotImplementedError

    def internet_ok(self) -> bool:
        # Prefer a TCP probe (works even where outbound ICMP is blocked),
        # then fall back to ICMP ping.
        try:
            import socket
            sock = socket.create_connection(("1.1.1.1", 443), timeout=2)
            sock.close()
            return True
        except Exception:
            pass
        ping = shutil.which("ping") or "ping"
        if IS_MAC:
            cmd = [ping, "-c", "1", "-t", "3", "1.1.1.1"]
        elif IS_LINUX:
            cmd = [ping, "-c", "1", "-W", "2", "1.1.1.1"]
        else:
            cmd = [ping, "-c", "1", "1.1.1.1"]
        try:
            r = subprocess.run(cmd, capture_output=True, timeout=5)
            return r.returncode == 0
        except Exception:
            return False


class MacOSOps(PlatformOps):
    name = "darwin"

    def _launchctl(self, *args: str) -> subprocess.CompletedProcess:
        return subprocess.run(["/bin/launchctl", *args], capture_output=True, text=True)

    def install_service(self, script: Path, python: Path, log: Path) -> Tuple[int, str]:
        plist = MAC_PLIST_TEMPLATE.format(
            label=SERVICE_LABEL, script=script, python=python, log=log, command="\n        <string>daemon</string>"
        )
        PLIST_PATH.parent.mkdir(parents=True, exist_ok=True)
        PLIST_PATH.write_text(plist, encoding="utf-8")
        self._launchctl("bootout", "gui/{}/{}".format(os.getuid(), SERVICE_LABEL))
        r = self._launchctl("bootstrap", "gui/{}".format(os.getuid()), str(PLIST_PATH))
        if r.returncode == 0:
            # Restart the daemon so it picks up the new code without a kill-race:
            # kickstart is SIGTERM-graceful, and save_state is atomic so
            # enable/disable state can never be torn mid-write.
            self._launchctl("kickstart", "-k", "gui/{}/{}".format(os.getuid(), SERVICE_LABEL))
        else:
            return 1, "launchctl bootstrap failed: " + (r.stderr or r.stdout).strip()
        return 0, "installed launchd job {}".format(PLIST_PATH)

    def uninstall_service(self) -> int:
        for label in (SERVICE_LABEL, "com.local.vpn-connector"):
            self._launchctl("bootout", "gui/{}/{}".format(os.getuid(), label))
            stale = HOME / "Library" / "LaunchAgents" / (label + ".plist")
            if stale.exists():
                stale.unlink()
        return 0

    def install_tray(self, script: Path, python: Path) -> Tuple[int, str]:
        plist = MAC_PLIST_TEMPLATE.format(
            label=TRAY_LABEL, script=str(HERE / "tray.py"), python=python, log=LOG_PATH, command=""
        )
        TRAY_PLIST_PATH.parent.mkdir(parents=True, exist_ok=True)
        TRAY_PLIST_PATH.write_text(plist, encoding="utf-8")
        self._launchctl("bootout", "gui/{}/{}".format(os.getuid(), TRAY_LABEL))
        r = self._launchctl("bootstrap", "gui/{}".format(os.getuid()), str(TRAY_PLIST_PATH))
        if r.returncode != 0:
            return 1, "launchctl bootstrap failed: " + (r.stderr or r.stdout).strip()
        return 0, "installed tray launchd job {}".format(TRAY_PLIST_PATH)

    def uninstall_tray(self) -> int:
        self._launchctl("bootout", "gui/{}/{}".format(os.getuid(), TRAY_LABEL))
        if TRAY_PLIST_PATH.exists():
            TRAY_PLIST_PATH.unlink()
        return 0

    def copy_to_clipboard(self, text: str) -> None:
        subprocess.run(["/usr/bin/pbcopy"], input=text, text=True, check=False)

    def default_route(self) -> str:
        try:
            r = subprocess.run(
                ["/sbin/route", "-n", "get", "default"], capture_output=True, text=True
            )
            return r.stdout
        except Exception as exc:
            return "route lookup failed: {!r}".format(exc)

    def dns_servers(self) -> str:
        try:
            r = subprocess.run(["/usr/sbin/scutil"], input="show State:/Network/Global/DNS\n",
                               capture_output=True, text=True)
            return r.stdout
        except Exception as exc:
            return "dns lookup failed: {!r}".format(exc)

    def wifi_reset(self) -> Tuple[int, str]:
        # macOS: power-cycle the Wi-Fi interface via networksetup.
        iface = _airport_device()
        if not iface:
            return 1, "no AirPort/Wi-Fi interface found"
        try:
            off = subprocess.run(["/usr/sbin/networksetup", "-setairportpower", iface, "off"],
                                 capture_output=True, text=True, timeout=15)
            time.sleep(3)
            on = subprocess.run(["/usr/sbin/networksetup", "-setairportpower", iface, "on"],
                                capture_output=True, text=True, timeout=15)
            if off.returncode != 0 or on.returncode != 0:
                return 1, "networksetup failed: " + (off.stderr or on.stderr).strip()
            return 0, "Wi-Fi ({}) power-cycled".format(iface)
        except Exception as exc:
            return 1, "Wi-Fi reset failed: {!r}".format(exc)


class LinuxOps(PlatformOps):
    name = "linux"

    def _systemctl(self, *args: str) -> subprocess.CompletedProcess:
        return subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True)

    def _unit_path(self, label: str) -> Path:
        return HOME / ".config" / "systemd" / "user" / (label + ".service")

    def _write_unit(self, label: str, script: Path, python: Path, log: Path,
                    extra_exec: Optional[List[str]] = None) -> Path:
        exec_args = [str(python), str(script)] + (extra_exec or [])
        unit = SYSTEMD_UNIT_TEMPLATE.format(
            description=label,
            exec_start=" ".join(_quote(a) for a in exec_args),
            log=log,
        )
        path = self._unit_path(label)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(unit, encoding="utf-8")
        return path

    def install_service(self, script: Path, python: Path, log: Path) -> Tuple[int, str]:
        self._write_unit(SERVICE_LABEL, script, python, log, extra_exec=["daemon"])
        self._systemctl("daemon-reload")
        r = self._systemctl("enable", "--now", SERVICE_LABEL + ".service")
        if r.returncode != 0:
            return 1, "systemctl enable failed: " + (r.stderr or r.stdout).strip()
        return 0, "installed systemd user unit {}".format(SERVICE_LABEL + ".service")

    def uninstall_service(self) -> Tuple[int, str]:
        self._systemctl("disable", "--now", SERVICE_LABEL + ".service")
        p = self._unit_path(SERVICE_LABEL)
        if p.exists():
            p.unlink()
        self._systemctl("daemon-reload")
        return 0

    def install_tray(self, script: Path, python: Path) -> Tuple[int, str]:
        # The tray lives in tray.py, a sibling of the vpn script.
        tray_script = script.parent / "tray.py"
        # systemd user unit for the tray (so it stays running).
        self._write_unit(TRAY_LABEL, tray_script, python, LOG_PATH)
        self._systemctl("daemon-reload")
        r = self._systemctl("enable", "--now", TRAY_LABEL + ".service")
        # Also drop an autostart .desktop entry for desktop sessions.
        autostart = HOME / ".config" / "autostart"
        autostart.mkdir(parents=True, exist_ok=True)
        (autostart / (TRAY_LABEL + ".desktop")).write_text(
            LINUX_AUTOSTART_TEMPLATE.format(
                label=TRAY_LABEL, python=python, script=tray_script
            ),
            encoding="utf-8",
        )
        if r.returncode != 0:
            return 1, "systemctl enable failed: " + (r.stderr or r.stdout).strip()
        return 0, "installed systemd user unit + autostart entry"

    def uninstall_tray(self) -> int:
        self._systemctl("disable", "--now", TRAY_LABEL + ".service")
        p = self._unit_path(TRAY_LABEL)
        if p.exists():
            p.unlink()
        autostart = HOME / ".config" / "autostart" / (TRAY_LABEL + ".desktop")
        if autostart.exists():
            autostart.unlink()
        self._systemctl("daemon-reload")
        return 0

    def copy_to_clipboard(self, text: str) -> None:
        for tool, args in (("wl-copy", []), ("xclip", ["-selection", "clipboard"]),
                           ("xsel", ["--clipboard", "--input"])):
            if shutil.which(tool):
                try:
                    subprocess.run([tool] + args, input=text.encode("utf-8"), check=False,
                                   timeout=5)
                    return
                except Exception:
                    continue
        # Fall back to printing so the code is at least visible.
        print("(no clipboard tool found — copy manually)")

    def default_route(self) -> str:
        try:
            r = subprocess.run(["ip", "route", "show", "default"], capture_output=True,
                               text=True)
            return r.stdout
        except Exception as exc:
            return "route lookup failed: {!r}".format(exc)

    def dns_servers(self) -> str:
        # Ubuntu LTS uses systemd-resolved.
        out = ""
        try:
            r = subprocess.run(["resolvectl", "status"], capture_output=True, text=True)
            if r.returncode == 0:
                out = r.stdout
        except Exception:
            pass
        if not out:
            try:
                out = Path("/etc/resolv.conf").read_text(encoding="utf-8")
            except Exception as exc:
                out = "dns lookup failed: {!r}".format(exc)
        return out

    def wifi_reset(self) -> Tuple[int, str]:
        # Ubuntu LTS ships NetworkManager; nmcli is the correct toggle.
        if shutil.which("nmcli"):
            try:
                off = subprocess.run(["nmcli", "radio", "wifi", "off"], capture_output=True,
                                     text=True, timeout=15)
                time.sleep(3)
                on = subprocess.run(["nmcli", "radio", "wifi", "on"], capture_output=True,
                                    text=True, timeout=15)
                if off.returncode != 0 or on.returncode != 0:
                    return 1, "nmcli failed: " + (off.stderr or on.stderr).strip()
                return 0, "Wi-Fi radio toggled via nmcli"
            except Exception as exc:
                return 1, "nmcli wifi reset failed: {!r}".format(exc)
        if shutil.which("rfkill"):
            try:
                off = subprocess.run(["rfkill", "block", "wifi"], capture_output=True,
                                     text=True, timeout=15)
                time.sleep(3)
                on = subprocess.run(["rfkill", "unblock", "wifi"], capture_output=True,
                                    text=True, timeout=15)
                if off.returncode != 0 or on.returncode != 0:
                    return 1, "rfkill failed: " + (off.stderr or on.stderr).strip()
                return 0, "Wi-Fi radio toggled via rfkill"
            except Exception as exc:
                return 1, "rfkill wifi reset failed: {!r}".format(exc)
        return 1, "no nmcli/rfkill available for Wi-Fi reset"


def _airport_device() -> Optional[str]:
    try:
        r = subprocess.run(["networksetup", "-listallhardwareports"],
                           capture_output=True, text=True)
        lines = r.stdout.splitlines()
        for i, line in enumerate(lines):
            if "Wi-Fi" in line and i + 1 < len(lines):
                return lines[i + 1].split("Device:")[-1].strip()
    except Exception:
        pass
    return None


def _quote(arg: str) -> str:
    if any(c in arg for c in " \t\n\"'\\$`!#&*|;:<>(){}~^"):
        return '"' + arg.replace('"', '\\"') + '"'
    return arg


def get_ops() -> PlatformOps:
    if IS_MAC:
        return MacOSOps()
    if IS_LINUX:
        return LinuxOps()
    return PlatformOps()



# ---------------------------------------------------------------------------
# Config + state
# ---------------------------------------------------------------------------


def load_config() -> Dict[str, Any]:
    if not CONFIG_PATH.exists():
        raise VPNError(
            "Config not found: {}\nCreate it with at least {{\"totp_secret\": \"...\"}}".format(CONFIG_PATH)
        )
    try:
        cfg = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
    except ValueError as exc:
        raise VPNError("Invalid JSON in {}: {}".format(CONFIG_PATH, exc))
    if not isinstance(cfg, dict) or not cfg.get("totp_secret"):
        raise VPNError("Config must contain a non-empty \"totp_secret\"")
    cfg.setdefault("pin", "")
    cfg.setdefault("auto_wifi_reset", False)
    cfg.setdefault("pritunl_client", get_ops().detect_client(cfg))
    return cfg


def load_state() -> Dict[str, Any]:
    if STATE_PATH.exists():
        try:
            data = json.loads(STATE_PATH.read_text(encoding="utf-8"))
            if isinstance(data, dict):
                return data
        except ValueError:
            pass
    return {"enabled": True, "user_action": "auto"}


def save_state(state: Dict[str, Any]) -> None:
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    # Unique temp name so concurrent writers cannot clobber each other.
    fd, tmp = tempfile.mkstemp(dir=str(STATE_PATH.parent), prefix="state-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(json.dumps(state, indent=2) + "\n")
        os.replace(tmp, str(STATE_PATH))  # atomic swap
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def is_enabled() -> bool:
    return bool(load_state().get("enabled", True))


# ---------------------------------------------------------------------------
# TOTP (RFC 6238, SHA-1, 6 digits, 30s period — Pritunl defaults)
# ---------------------------------------------------------------------------


def totp_now(secret: str) -> Tuple[str, int]:
    s = secret.replace(" ", "").upper()
    key = base64.b32decode(s + "=" * (-len(s) % 8), casefold=True)
    counter = int(time.time()) // 30
    digest = hmac.new(key, struct.pack(">Q", counter), hashlib.sha1).digest()
    offset = digest[-1] & 0x0F
    binary = struct.unpack(">I", digest[offset:offset + 4])[0] & 0x7FFFFFFF
    code = "{:06d}".format(binary % 1000000)
    return code, 30 - int(time.time()) % 30


# ---------------------------------------------------------------------------
# pritunl-client interaction
# ---------------------------------------------------------------------------


def run_client(client: str, *args: str, timeout: int = 30) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(
            [client] + list(args), capture_output=True, text=True, timeout=timeout
        )
    except FileNotFoundError:
        raise VPNError("pritunl-client not found at: " + client)
    except subprocess.TimeoutExpired:
        raise VPNError("pritunl-client timed out: {} {}".format(client, " ".join(args)))


_HEADER_MAP = {
    "id": "id",
    "name": "name",
    "state": "state",
    "server address": "server_addr",
    "client address": "client_addr",
}


def parse_list(text: str) -> List[Dict[str, str]]:
    """Parse the ``pritunl-client list`` ASCII table by header name.

    Maps columns by header label (not fixed index) so state/server/client stay
    correct even if pritunl-client reorders its columns. The old fixed-index
    parser read TYPE as STATE and shifted server/client, which made the
    watchdog think an already-Active profile was "System" and spam reconnects.
    """
    rows: List[Dict[str, str]] = []
    idx: Dict[str, int] = {}
    for line in text.splitlines():
        s = line.strip()
        if not s.startswith("|"):
            continue
        cells = [c.strip() for c in s.strip("|").split("|")]
        low = [c.lower() for c in cells]
        if "id" in low:  # header row (first cell is "id")
            idx = {_HEADER_MAP[h]: i for i, h in enumerate(low) if h in _HEADER_MAP}
            continue
        if not idx or len(cells) <= max(idx.values()):
            continue
        if not cells[idx["id"]]:
            continue
        rows.append({k: cells[i] for k, i in idx.items()})
    return rows


def get_rows(client: str) -> List[Dict[str, str]]:
    result = run_client(client, "list")
    if result.returncode != 0:
        raise VPNError("pritunl-client list failed: " + (result.stderr or result.stdout).strip())
    return parse_list(result.stdout)


def resolve_profile_id(cfg: Dict[str, Any]) -> str:
    pid = cfg.get("profile_id", "")
    if pid:
        return pid
    rows = get_rows(cfg["pritunl_client"])
    if len(rows) == 1:
        return rows[0]["id"]
    if not rows:
        raise VPNError("No pritunl-client profiles found; register one and set \"profile_id\" in config")
    raise VPNError(
        "Multiple profiles registered; set \"profile_id\" in {}: {}".format(
            CONFIG_PATH, ", ".join(r["id"] for r in rows)
        )
    )


def get_profile(client: str, pid: str) -> Optional[Dict[str, str]]:
    for row in get_rows(client):
        if row["id"] == pid:
            return row
    return None


def start_and_poll(client: str, pid: str, secret: str, pin: str) -> Tuple[Optional[Dict[str, str]], str]:
    """Start the profile with PIN+TOTP; poll until active. Returns (row, error)."""
    code, _ = totp_now(secret)
    password = pin + code if pin else code
    result = run_client(client, "start", pid, "-p", password)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip().splitlines()
        return None, "start failed: " + (detail[-1] if detail else "exit {}".format(result.returncode))

    deadline = time.time() + CONNECT_TIMEOUT
    while time.time() < deadline:
        time.sleep(2)
        row = get_profile(client, pid)
        state = (row or {}).get("state", "unknown").lower()
        if state == "active":
            addr_deadline = time.time() + 6
            while time.time() < addr_deadline and (row or {}).get("client_addr", "-") in ("", "-"):
                time.sleep(1)
                row = get_profile(client, pid) or row
            return row, ""
        if state == "inactive":
            return None, "rejected"
    # Timed out mid-connect: clean up the half-open tunnel so it does not
    # poison the network stack / leave the default route stale.
    run_client(client, "stop", pid, timeout=15)
    return None, "timeout (still connecting?)"


def connect_profile(cfg: Dict[str, Any]) -> Tuple[int, str]:
    client = cfg["pritunl_client"]
    pid = resolve_profile_id(cfg)
    row = get_profile(client, pid)
    if row is None:
        return 1, "profile {} not found in pritunl-client".format(pid)
    if row["state"].lower() == "active":
        return 0, "already connected: {} -> {}".format(row["client_addr"], row["server_addr"])

    row, error = start_and_poll(client, pid, cfg["totp_secret"], cfg["pin"])
    if error == "rejected":
        row, error = start_and_poll(client, pid, cfg["totp_secret"], cfg["pin"])
    if row is not None:
        return 0, "connected: {} -> {}".format(row["client_addr"], row["server_addr"])
    return 1, "not connected: " + error


def log(message: str) -> None:
    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S")
    with open(LOG_PATH, "a", encoding="utf-8") as handle:
        handle.write("[{}] {}\n".format(stamp, message))


# States we should NOT try to reconnect from — sleeping machine, daemon busy,
# or a transitional stop. Touching these caused the post-sleep spam/instability.
DEFER_STATES = ("active", "connecting", "system", "reconnecting", "exiting", "disconnecting")


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------


def cmd_connect(cfg: Dict[str, Any]) -> int:
    save_state({**load_state(), "user_action": "auto"})
    code, message = connect_profile(cfg)
    print(message)
    return code


def _stop_profile(cfg: Dict[str, Any]) -> int:
    client = cfg["pritunl_client"]
    pid = resolve_profile_id(cfg)
    row = get_profile(client, pid)
    if row is None:
        print("profile {} not found".format(pid))
        return 1
    if row["state"].lower() == "inactive":
        print("already disconnected")
        return 0
    result = run_client(client, "stop", pid)
    if result.returncode != 0:
        print("stop failed: " + (result.stderr or result.stdout).strip())
        return 1
    deadline = time.time() + 20
    state = "unknown"
    while time.time() < deadline:
        time.sleep(2)
        row = get_profile(client, pid)
        state = (row or {}).get("state", "unknown").lower()
        if state == "inactive":
            break
    print("disconnected" if state == "inactive" else "state: " + state)
    return 0 if state == "inactive" else 1


def cmd_totp(cfg: Dict[str, Any], copy_to_clipboard: bool = False) -> int:
    code, remaining = totp_now(cfg["totp_secret"])
    if copy_to_clipboard:
        get_ops().copy_to_clipboard(code)
        print("{} (valid {}s) — copied".format(code, remaining))
    else:
        print("{} (valid {}s)".format(code, remaining))
    return 0


def cmd_status(cfg: Dict[str, Any]) -> int:
    client = cfg["pritunl_client"]
    pid = resolve_profile_id(cfg)
    row = get_profile(client, pid)
    enabled = is_enabled()
    auto = "on" if enabled else "off"
    if row is None:
        print("Profile: {}\nState:   not found\nAuto-reconnect: {}".format(pid, auto))
        return 1
    print(
        "Profile: {} ({})\nState:   {}\nClient:  {}\nServer:  {}\nAuto-reconnect: {}".format(
            row["id"], row["name"], row["state"], row["client_addr"], row["server_addr"], auto
        )
    )
    return 0 if row["state"].lower() == "active" else 1


def cmd_disconnect(cfg: Dict[str, Any]) -> int:
    # Set the *intent* before stopping so the watchdog never reconnects a
    # deliberate disconnect (it checks user_action every pass).
    save_state({**load_state(), "user_action": "manual_off"})
    return _stop_profile(cfg)


def cmd_enable(cfg: Dict[str, Any]) -> int:
    save_state({**load_state(), "enabled": True, "user_action": "auto"})
    print("auto-reconnect enabled")
    code, message = connect_profile(cfg)
    print(message)
    return code


def cmd_disable(cfg: Dict[str, Any]) -> int:
    save_state({**load_state(), "enabled": False, "user_action": "manual_off"})
    print("auto-reconnect disabled")
    return _stop_profile(cfg)


def cmd_enabled(cfg: Dict[str, Any]) -> int:
    print("on" if is_enabled() else "off")
    return 0


def cmd_ensure(cfg: Dict[str, Any]) -> int:
    """One-shot: connect if not connected AND auto-reconnect is enabled."""
    if not is_enabled():
        return 0
    client = cfg["pritunl_client"]
    try:
        pid = resolve_profile_id(cfg)
        row = get_profile(client, pid)
    except VPNError as exc:
        log("ensure error: {}".format(exc))
        return 1
    if row is None:
        log("ensure: profile {} not found".format(pid))
        return 1
    state = row["state"].lower()
    if state in DEFER_STATES:
        return 0
    if not get_ops().internet_ok():
        log("ensure: no internet reachability; deferring")
        return 1
    log("ensure: state={} -> connecting {}".format(state, pid))
    code, message = connect_profile(cfg)
    log("ensure: " + message)
    return code


def cmd_daemon(cfg: Dict[str, Any]) -> int:
    """Persistent watchdog loop (run under the service manager).

    Sleep-safe: does not fight the OS while asleep (``system``) or while the
    daemon is mid-transition, verifies internet reachability before dialing,
    and only (optionally) resets Wi-Fi after repeated post-wake failures.
    """
    client = cfg["pritunl_client"]
    ops = get_ops()
    log("daemon started (platform {} interval {}s)".format(ops.name, WATCHDOG_INTERVAL))
    last_wall = time.time()
    down_checks = 0
    while True:
        try:
            # Wake detection: if wall time jumped well beyond the poll interval,
            # the machine just woke — let macOS/Linux finish Wi-Fi/DNS.
            now = time.time()
            if now - last_wall > WATCHDOG_INTERVAL * 4:
                log("daemon: wake detected; settling {}s".format(WAKE_SETTLE_SECONDS))
                down_checks = 0
                time.sleep(WAKE_SETTLE_SECONDS)
            last_wall = now

            # Single source of truth: user intent from state.json.
            st = load_state()
            action = st.get("user_action", "auto")
            enabled = bool(st.get("enabled", True))

            if not enabled or action == "manual_off":
                # Disabled by user, or deliberately disconnected — stay down.
                down_checks = 0
                time.sleep(WATCHDOG_INTERVAL)
                continue

            pid = resolve_profile_id(cfg)
            row = get_profile(client, pid)
            state = (row or {}).get("state", "unknown").lower() if row else "missing"

            if state == "missing":
                log("daemon: profile {} not found".format(pid))
            elif state in DEFER_STATES:
                # connected, connecting, or asleep — leave it alone
                down_checks = 0
            else:
                # Down while enabled + auto: reconnect. This covers an
                # unexpected drop, a failed earlier attempt, and a tunnel that
                # was already down when the daemon started.
                st2 = load_state()
                if not st2.get("enabled", True) or st2.get("user_action", "auto") == "manual_off":
                    down_checks = 0
                    time.sleep(WATCHDOG_INTERVAL)
                    continue
                if not ops.internet_ok():
                    down_checks += 1
                    log("daemon: state={} but no internet; deferring".format(state))
                    if cfg.get("auto_wifi_reset") and down_checks >= WIFI_RESET_AFTER_FAILS:
                        code, msg = ops.wifi_reset()
                        log("daemon: wifi reset ({}) -> {}".format("ok" if code == 0 else "fail", msg))
                        down_checks = 0
                    time.sleep(WATCHDOG_INTERVAL * 2)
                    continue
                down_checks += 1
                log("daemon: state={} -> connecting {}".format(state, pid))
                code, message = connect_profile(cfg)
                log("daemon: " + message)
                if code != 0:
                    # If the user disconnected while we were dialing, undo it.
                    st3 = load_state()
                    if not st3.get("enabled", True) or st3.get("user_action", "auto") == "manual_off":
                        _stop_profile(cfg)
                        down_checks = 0
                    else:
                        time.sleep(WATCHDOG_INTERVAL * 3)
        except Exception as exc:  # never die
            log("daemon error: {!r}".format(exc))
        time.sleep(WATCHDOG_INTERVAL)


def cmd_diag(cfg: Dict[str, Any]) -> int:
    ops = get_ops()
    print("=== vpn diagnostics ({}) ===".format(ops.name))
    pid = resolve_profile_id(cfg)
    row = get_profile(cfg["pritunl_client"], pid)
    state = (row or {}).get("state", "missing")
    print("profile : {} ({})".format(pid, cfg.get("profile_id", "auto-detected")))
    print("state   : {}".format(state))
    print("client  : {}".format((row or {}).get("client_addr", "-")))
    print("server  : {}".format((row or {}).get("server_addr", "-")))
    print("internet: {}".format("ok" if ops.internet_ok() else "UNREACHABLE"))
    reset_tool = ("nmcli" if shutil.which("nmcli") else
                  "rfkill" if shutil.which("rfkill") else
                  "networksetup" if IS_MAC else "none")
    print("wifi    : reset tool={} auto_reset={}".format(
        reset_tool, "on" if cfg.get("auto_wifi_reset") else "off"))
    print("\n--- default route ---\n{}".format(ops.default_route().strip()))
    print("\n--- DNS ---\n{}".format(ops.dns_servers().strip()))
    if state.lower() != "active":
        log("diag: state={} internet={}".format(state, "ok" if ops.internet_ok() else "no"))
    return 0


def cmd_install(cfg: Dict[str, Any] = None, with_tray: bool = False) -> int:  # type: ignore[assignment]
    script = Path(__file__).resolve()
    python = Path(sys.executable)
    ops = get_ops()
    code, msg = ops.install_service(script, python, LOG_PATH)
    if code != 0:
        print("service install failed: " + msg)
        return code
    print("Installed service: {} ({})".format(SERVICE_LABEL, msg))
    print("  - starts at login, stays running, watchdog reconnects within ~{}s".format(WATCHDOG_INTERVAL + 10))
    print("  - log: {}".format(LOG_PATH))

    bin_dir = HOME / ".local" / "bin"
    bin_dir.mkdir(parents=True, exist_ok=True)
    link = bin_dir / "vpn"
    if link.is_symlink() or link.exists():
        link.unlink()
    link.symlink_to(script)
    print("CLI symlink: {} -> {}".format(link, script))

    if with_tray:
        tcode, tmsg = ops.install_tray(script, python)
        print("Tray: {} ({})".format("installed" if tcode == 0 else "FAILED", tmsg))
    return code


def cmd_uninstall() -> int:
    ops = get_ops()
    ops.uninstall_service()
    ops.uninstall_tray()
    link = HOME / ".local" / "bin" / "vpn"
    if link.is_symlink():
        link.unlink()
    print("Removed service, tray unit, and symlink")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="vpn", description="Cross-platform Pritunl client with TOTP + watchdog")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("connect", help="connect using PIN + TOTP")
    sub.add_parser("disconnect", help="disconnect")
    sub.add_parser("status", help="show profile state (exit 0 = connected)")
    p_totp = sub.add_parser("totp", help="print current TOTP code")
    p_totp.add_argument("--copy", action="store_true", help="also copy code to clipboard")
    sub.add_parser("enable", help="enable auto-reconnect and connect now")
    sub.add_parser("disable", help="disable auto-reconnect and disconnect now")
    sub.add_parser("enabled", help="print whether auto-reconnect is enabled")
    sub.add_parser("ensure", help="connect if not connected (one-shot)")
    sub.add_parser("daemon", help="run watchdog loop (used by service manager)")
    sub.add_parser("diag", help="routing/DNS/reachability diagnostics")
    p_install = sub.add_parser("install", help="install service manager unit (+ optional --tray)")
    p_install.add_argument("--tray", action="store_true", help="also install the menu-bar tray app")
    sub.add_parser("uninstall", help="remove service + tray + symlink")

    args = parser.parse_args()
    try:
        if args.command == "install":
            return cmd_install(with_tray=args.tray)
        if args.command == "uninstall":
            return cmd_uninstall()
        cfg = load_config()
        if args.command == "connect":
            return cmd_connect(cfg)
        if args.command == "disconnect":
            return cmd_disconnect(cfg)
        if args.command == "status":
            return cmd_status(cfg)
        if args.command == "totp":
            return cmd_totp(cfg, copy_to_clipboard=args.copy)
        if args.command == "enable":
            return cmd_enable(cfg)
        if args.command == "disable":
            return cmd_disable(cfg)
        if args.command == "enabled":
            return cmd_enabled(cfg)
        if args.command == "ensure":
            return cmd_ensure(cfg)
        if args.command == "daemon":
            return cmd_daemon(cfg)
        if args.command == "diag":
            return cmd_diag(cfg)
    except VPNError as exc:
        print("error: {}".format(exc), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
